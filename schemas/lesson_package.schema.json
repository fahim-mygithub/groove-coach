{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groove-coach/schemas/lesson_package.schema.json",
  "title": "Groove Coach lesson package manifest (groove.lesson/1)",
  "description": "Structure of manifest.json (spec §2.2, adaptive speed §8). Cross-field rules JSON Schema cannot express (windows and segments inside [0, duration_s], segment boundaries within 40 ms of a beat, strictly increasing beats, files covering the package, config_overrides keys, teach_order 1..N, adaptive-speed rate ordering) are enforced by groove_eval.lesson_package.validate_manifest.",
  "type": "object",
  "required": ["schema", "lesson_id", "course_slug", "lesson_slug", "package_version", "title", "requires", "extractor", "video", "reference", "beat_grid", "segments", "windows", "config_overrides", "practice", "files"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "groove.lesson/1" },
    "lesson_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "course_slug": { "$ref": "#/$defs/slug" },
    "lesson_slug": { "$ref": "#/$defs/slug" },
    "package_version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "requires": {
      "type": "object",
      "required": ["engine_major", "skeleton"],
      "additionalProperties": false,
      "properties": {
        "engine_major": { "type": "integer", "minimum": 1 },
        "skeleton": { "const": "groove.canonical/1" }
      }
    },
    "extractor": {
      "type": "object",
      "required": ["pose_model", "pose_model_sha256", "mediapipe_python", "running_mode", "num_poses"],
      "additionalProperties": false,
      "properties": {
        "pose_model": { "type": "string", "minLength": 1 },
        "pose_model_sha256": { "$ref": "#/$defs/sha256" },
        "hand_model": { "type": "string", "minLength": 1 },
        "hand_model_sha256": { "$ref": "#/$defs/sha256" },
        "mediapipe_python": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "running_mode": { "const": "VIDEO" },
        "num_poses": { "const": 1 }
      }
    },
    "video": {
      "type": "object",
      "required": ["file", "duration_s", "fps", "width", "height", "mirrored", "default_display_flip"],
      "additionalProperties": false,
      "properties": {
        "file": { "$ref": "#/$defs/file_name" },
        "duration_s": { "type": "number", "exclusiveMinimum": 0 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "mirrored": { "type": "boolean" },
        "default_display_flip": { "type": "boolean" }
      }
    },
    "poster": { "$ref": "#/$defs/file_name" },
    "reference": {
      "type": "object",
      "required": ["file", "frame_count"],
      "additionalProperties": false,
      "properties": {
        "file": { "$ref": "#/$defs/file_name" },
        "frame_count": { "type": "integer", "minimum": 1 }
      }
    },
    "beat_grid": {
      "type": "object",
      "required": ["bpm", "anchor_s", "source", "beats"],
      "additionalProperties": false,
      "properties": {
        "bpm": { "type": "number", "exclusiveMinimum": 0 },
        "anchor_s": { "type": "number", "minimum": 0 },
        "source": { "enum": ["author_confirmed", "detector"] },
        "detector": { "type": "string", "minLength": 1 },
        "beats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["t", "phrase", "count"],
            "additionalProperties": false,
            "properties": {
              "t": { "type": "number", "minimum": 0 },
              "phrase": { "type": "integer", "minimum": 1 },
              "count": { "type": "integer", "minimum": 1, "maximum": 8 }
            }
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "start_s", "end_s", "teach_order"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "kind": { "enum": ["segment", "full_run"] },
          "title": { "type": "string", "minLength": 1 },
          "start_s": { "type": "number", "minimum": 0 },
          "end_s": { "type": "number", "exclusiveMinimum": 0 },
          "teach_order": { "type": "integer", "minimum": 1 },
          "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
          "focus": { "type": "array", "items": { "enum": ["arms", "hands", "hips", "feet", "torso", "head"] } },
          "cues": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "config_overrides": { "$ref": "#/$defs/config_overrides" },
          "adaptive_speed": { "$ref": "#/$defs/adaptive_speed" }
        }
      }
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "start_s", "end_s"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["clasp", "occlusion"] },
          "start_s": { "type": "number", "minimum": 0 },
          "end_s": { "type": "number", "exclusiveMinimum": 0 },
          "mask": { "type": "array", "items": { "enum": ["hand_shape"] } },
          "tolerance_scale": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/joint_name" },
            "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "config_overrides": { "$ref": "#/$defs/config_overrides" },
    "practice": {
      "type": "object",
      "required": ["count_in_beats", "adaptive_speed"],
      "additionalProperties": false,
      "properties": {
        "count_in_beats": { "type": "integer", "minimum": 0, "maximum": 16 },
        "adaptive_speed": { "$ref": "#/$defs/adaptive_speed" }
      }
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/file_name" },
      "additionalProperties": { "$ref": "#/$defs/sha256" }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "file_name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
    "joint_name": {
      "enum": ["root", "spine", "centerShoulder", "leftHip", "leftKnee", "leftAnkle", "rightHip", "rightKnee", "rightAnkle", "leftShoulder", "leftElbow", "leftWrist", "rightShoulder", "rightElbow", "rightWrist", "leftHeel", "leftFootIndex", "rightHeel", "rightFootIndex", "nose"]
    },
    "config_overrides": {
      "description": "Partial config deep-merged over config/groove_config.json (bundled < lesson < segment). Every leaf path must exist in the bundled config with the same JSON type, or be a §3.2 key: scoring_thresholds.shape.arm_weight, scoring_thresholds.gate.timing_source.",
      "type": "object"
    },
    "adaptive_speed": {
      "description": "Playback-rate policy (spec §8 Q6). A segment starts at start_rate; promote_after consecutive passing takes step the rate up by step_up, demote_after consecutive failing takes step it down by step_down, clamped to [min_rate, max_rate]. The next segment unlocks after one passing take at a rate >= unlock_next_at_rate. Rules min_rate <= start_rate <= max_rate and min_rate <= unlock_next_at_rate <= max_rate are checked by validate_manifest.",
      "type": "object",
      "required": ["min_rate", "start_rate", "max_rate", "step_up", "step_down", "promote_after", "demote_after", "unlock_next_at_rate"],
      "additionalProperties": false,
      "properties": {
        "min_rate": { "type": "number", "minimum": 0.5, "maximum": 1.0 },
        "start_rate": { "type": "number", "minimum": 0.5, "maximum": 1.0 },
        "max_rate": { "type": "number", "minimum": 0.5, "maximum": 1.0 },
        "step_up": { "type": "number", "minimum": 0.01, "maximum": 0.5 },
        "step_down": { "type": "number", "minimum": 0.01, "maximum": 0.5 },
        "promote_after": { "type": "integer", "minimum": 1 },
        "demote_after": { "type": "integer", "minimum": 1 },
        "unlock_next_at_rate": { "type": "number", "minimum": 0.5, "maximum": 1.0 }
      }
    }
  }
}
